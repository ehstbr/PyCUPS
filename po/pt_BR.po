#: src/print_archive/application.py:361
msgid "Checking for Updates"
msgstr "Verificando atualizações"

#: src/print_archive/application.py:362
msgid "Contacting the GitHub version service…"
msgstr "Consultando o serviço de versões do GitHub…"

#: src/print_archive/application.py:371
msgid "Could Not Check for Updates"
msgstr "Não foi possível verificar atualizações"

#: src/print_archive/application.py:373
msgid ""
"The version information could not be obtained. Check your connection and try "
"again later."
msgstr ""
"Não foi possível obter as informações de versão. Verifique sua conexão e "
"tente novamente mais tarde."

#: src/print_archive/application.py:386
#, python-brace-format
msgid "{app_name} Is Up to Date"
msgstr "O {app_name} está atualizado"

#: src/print_archive/application.py:387
msgid "You are already using the latest available version."
msgstr "Você já está usando a versão mais recente disponível."

#: src/print_archive/application.py:398 src/print_archive/ui/dialogs.py:14
msgid "Close"
msgstr "Fechar"

#: src/print_archive/core/cups_service.py:99
msgid "python3-cups is required to access the print service."
msgstr "python3-cups é necessário para acessar o serviço de impressão."

#: src/print_archive/core/cups_service.py:185
msgid "A target-sheet preview is available for retained PDF jobs only."
msgstr ""
"O preview da folha de destino está disponível somente para jobs de PDF "
"retidos."

#: src/print_archive/core/cups_service.py:222
#, python-brace-format
msgid "Document {number} of this job could not be retrieved."
msgstr "Não foi possível obter o documento {number} deste job."

#: src/print_archive/core/cups_service.py:240
msgid "Copies must be between 1 and 999."
msgstr "A quantidade de cópias deve estar entre 1 e 999."

#: src/print_archive/core/cups_service.py:261
#, python-brace-format
msgid "CUPS could not restart job #{job_id}: {detail}"
msgstr "O CUPS não conseguiu reiniciar o job nº {job_id}: {detail}"

#: src/print_archive/core/cups_service.py:266
#: src/print_archive/core/cups_service.py:278
#: src/print_archive/core/page_ranges.py:24
msgid "all pages"
msgstr "todas as páginas"

#: src/print_archive/core/cups_service.py:270
msgid "Raw printer data can only be restarted exactly on its original printer."
msgstr ""
"Dados brutos de impressora só podem ser reiniciados exatamente na impressora "
"original."

#: src/print_archive/core/cups_service.py:274
msgid ""
"This multi-document job can only be restarted exactly on its original "
"printer."
msgstr ""
"Este job com vários documentos só pode ser reiniciado exatamente na "
"impressora original."

#: src/print_archive/core/cups_service.py:281
msgid "Selected-page reprinting is available for PDF jobs only."
msgstr ""
"A reimpressão de páginas selecionadas está disponível apenas para jobs em "
"PDF."

#: src/print_archive/core/cups_service.py:292
msgid "The selected paper size is invalid."
msgstr "O tamanho de papel selecionado é inválido."

#: src/print_archive/core/cups_service.py:296
msgid "The selected scaling mode is invalid."
msgstr "O modo de escala selecionado é inválido."

#: src/print_archive/core/cups_service.py:310
#, python-brace-format
msgid "CUPS could not submit the reprint: {detail}"
msgstr "O CUPS não conseguiu enviar a reimpressão: {detail}"

#: src/print_archive/core/cups_service.py:318
msgid "This job cannot be exported as a single file."
msgstr "Este job não pode ser exportado como um único arquivo."

#: src/print_archive/core/cups_service.py:332
#, python-brace-format
msgid "CUPS could not delete job #{job_id}: {detail}"
msgstr "O CUPS não conseguiu excluir o job nº {job_id}: {detail}"

#: src/print_archive/core/cups_service.py:351
#, python-brace-format
msgid "Removed {removed} jobs, but {failed} could not be removed: {sample}"
msgstr ""
"Foram removidos {removed} jobs, mas {failed} não puderam ser removidos: "
"{sample}"

#: src/print_archive/core/cups_service.py:374
msgid "File retention must be between 1 and 3650 days."
msgstr "A retenção dos arquivos deve estar entre 1 e 3.650 dias."

#: src/print_archive/core/cups_service.py:376
msgid "History retention must be between 1 and 3650 days."
msgstr "A retenção do histórico deve estar entre 1 e 3.650 dias."

#: src/print_archive/core/cups_service.py:378
msgid "MaxJobs must be between 1 and 1,000,000, or unlimited."
msgstr "MaxJobs deve estar entre 1 e 1.000.000, ou ser ilimitado."

#: src/print_archive/core/cups_service.py:382
#: src/print_archive/core/cups_service.py:419
msgid "The administrative settings helper is not installed."
msgstr "O auxiliar administrativo de configurações não está instalado."

#: src/print_archive/core/cups_service.py:395
#: src/print_archive/core/cups_service.py:438
msgid "Administrator authentication was canceled."
msgstr "A autenticação de administrador foi cancelada."

#: src/print_archive/core/cups_service.py:396
msgid "CUPS rejected the new retention settings."
msgstr "O CUPS rejeitou as novas configurações de retenção."

#: src/print_archive/core/cups_service.py:416
msgid "Invalid global CUPS settings."
msgstr "Configurações globais do CUPS inválidas."

#: src/print_archive/core/cups_service.py:439
msgid "CUPS rejected the global server settings."
msgstr "O CUPS rejeitou as configurações globais do servidor."

#: src/print_archive/core/cups_service.py:462
#: src/print_archive/core/cups_service.py:504
msgid "The CUPS restart wait was canceled."
msgstr "A espera pela reinicialização do CUPS foi cancelada."

#: src/print_archive/core/cups_service.py:486
msgid "CUPS did not become available again after the configuration change."
msgstr "O CUPS não voltou a ficar disponível após a alteração da configuração."

#: src/print_archive/core/cups_service.py:489
#, python-brace-format
msgid "{message} Last connection error: {detail}"
msgstr "{message} Último erro de conexão: {detail}"

#: src/print_archive/core/cups_service.py:516
#: src/print_archive/ui/main_window.py:589 src/print_archive/ui/settings.py:587
msgid "unknown"
msgstr "desconhecido"

#: src/print_archive/core/cups_service.py:535
msgid "cupsctl was not found. Install cups-client."
msgstr "cupsctl não foi encontrado. Instale cups-client."

#: src/print_archive/core/cups_service.py:540
msgid "Could not read CUPS settings."
msgstr "Não foi possível ler as configurações do CUPS."

#: src/print_archive/core/cups_service.py:593
msgid "CUPS authentication was canceled."
msgstr "A autenticação no CUPS foi cancelada."

#: src/print_archive/core/cups_service.py:683
msgid ""
"CUPS denied access to the retained file. Check the username and password."
msgstr ""
"O CUPS negou o acesso ao arquivo retido. Verifique o usuário e a senha."

#: src/print_archive/core/cups_service.py:685
msgid "CUPS no longer has the retained file for this job."
msgstr "O CUPS não possui mais o arquivo retido deste job."

#: src/print_archive/core/cups_service.py:686
#, python-brace-format
msgid "CUPS could not provide the retained file: {detail}"
msgstr "O CUPS não conseguiu fornecer o arquivo retido: {detail}"

#: src/print_archive/core/cups_service.py:691
msgid "unknown CUPS error"
msgstr "erro desconhecido do CUPS"

#: src/print_archive/core/documents.py:114
msgid "The PDF changed while its pages were being prepared."
msgstr "O PDF mudou enquanto suas páginas estavam sendo preparadas."

#: src/print_archive/core/page_ranges.py:36
#: src/print_archive/core/page_ranges.py:63
msgid "The document has no printable pages."
msgstr "O documento não possui páginas imprimíveis."

#: src/print_archive/core/page_ranges.py:39
msgid "Enter at least one page number."
msgstr "Digite pelo menos um número de página."

#: src/print_archive/core/page_ranges.py:45
msgid "There is an empty item in the page range."
msgstr "Há um item vazio no intervalo de páginas."

#: src/print_archive/core/page_ranges.py:48
#, python-brace-format
msgid "Invalid range: {range}."
msgstr "Intervalo inválido: {range}."

#: src/print_archive/core/page_ranges.py:53
#, python-brace-format
msgid "Range {range} is reversed."
msgstr "O intervalo {range} está invertido."

#: src/print_archive/core/page_ranges.py:87
#, python-brace-format
msgid "Invalid page number: {value}."
msgstr "Número de página inválido: {value}."

#: src/print_archive/core/page_ranges.py:90
#, python-brace-format
msgid "Page {page} is outside the document (1-{total})."
msgstr "A página {page} está fora do documento (1-{total})."

#: src/print_archive/core/preview.py:24
msgid "Install poppler-utils to preview PDF files."
msgstr "Instale poppler-utils para pré-visualizar arquivos PDF."

#: src/print_archive/core/preview.py:43
msgid "Unknown PDF rendering error."
msgstr "Erro desconhecido ao renderizar o PDF."

#: src/print_archive/core/preview.py:47
msgid "The PDF renderer did not create a preview."
msgstr "O renderizador de PDF não criou uma pré-visualização."

#: src/print_archive/ui/about.py:36
#, python-brace-format
msgid ""
"{tagline} — View, preview, reprint, export, and administer retained CUPS "
"jobs."
msgstr ""
"{tagline} — visualize, pré-visualize, reimprima, exporte e administre jobs "
"retidos pelo CUPS."

#: src/print_archive/ui/about.py:47
msgid "Source code on GitHub"
msgstr "Código-fonte no GitHub"

#: src/print_archive/ui/about.py:49
msgid "Check for Updates"
msgstr "Verificar atualizações"

#: src/print_archive/ui/about.py:59
msgid "Report a problem"
msgstr "Relatar um problema"

#: src/print_archive/ui/about.py:60
msgid "Complete changelog"
msgstr "Changelog completo"

#: src/print_archive/ui/about.py:61
msgid "Third-party projects and licenses"
msgstr "Projetos de terceiros e licenças"

#: src/print_archive/ui/about.py:64
msgid "Printing Technologies"
msgstr "Tecnologias de impressão"

#: src/print_archive/ui/about.py:68
msgid "Desktop Technologies"
msgstr "Tecnologias de desktop"

#: src/print_archive/ui/about.py:71
msgid "Document Processing"
msgstr "Processamento de documentos"

#: src/print_archive/ui/about.py:73
msgid "Languages"
msgstr "Idiomas"

#: src/print_archive/ui/about_content.py:11
msgid "Version 0.1.14"
msgstr "Versão 0.1.14"

#: src/print_archive/ui/about_content.py:13
msgid "Panning a zoomed preview is now anchored to the fixed viewport."
msgstr ""
"A navegação por arraste em um preview ampliado agora fica ancorada à área "
"de visualização fixa."

#: src/print_archive/ui/about_content.py:14
msgid "Document movement no longer feeds back into the mouse drag coordinates."
msgstr ""
"O movimento do documento não interfere mais nas coordenadas de arraste do "
"mouse."

#: src/print_archive/ui/about_content.py:15
msgid "Queued preview recentering is canceled when manual panning begins."
msgstr ""
"O recentramento pendente do preview é cancelado quando a navegação manual "
"começa."

#: src/print_archive/ui/about_content.py:19
msgid "Version 0.1.13"
msgstr "Versão 0.1.13"

#: src/print_archive/ui/about_content.py:21
msgid "The main preview now loads the PyGObject Cairo integration explicitly."
msgstr ""
"O preview principal agora carrega explicitamente a integração Cairo do "
"PyGObject."

#: src/print_archive/ui/about_content.py:22
msgid ""
"The Debian package now installs the required Cairo bridge automatically."
msgstr ""
"O pacote Debian agora instala automaticamente a ponte Cairo necessária."

#: src/print_archive/ui/about_content.py:23
msgid ""
"Job and update titles with markup characters are displayed as literal text."
msgstr ""
"Títulos de jobs e atualizações com caracteres de markup são exibidos como "
"texto literal."

#: src/print_archive/ui/about_content.py:24
msgid "Preview and PDF page controls now share one compact horizontal toolbar."
msgstr ""
"Os controles do preview e das páginas do PDF agora compartilham uma única "
"barra horizontal compacta."

#: src/print_archive/ui/about_content.py:20
msgid "Version 0.1.12"
msgstr "Versão 0.1.12"

#: src/print_archive/ui/about_content.py:22
msgid ""
"Automatic update notices now wait until the main window is mapped and active."
msgstr ""
"Os avisos automáticos de atualização agora aguardam a janela principal ser "
"mapeada e ficar ativa."

#: src/print_archive/ui/about_content.py:23
msgid ""
"The desktop compositor can now center the startup update window over PyCUPS "
"reliably."
msgstr ""
"Agora o compositor da área de trabalho consegue centralizar de forma "
"confiável a janela de atualização inicial sobre o PyCUPS."

#: src/print_archive/ui/about_content.py:24
msgid "Manual update checks keep their existing centered behavior."
msgstr ""
"As verificações manuais de atualização mantêm o comportamento centralizado "
"já existente."

#: src/print_archive/ui/about_content.py:28
msgid "Version 0.1.11"
msgstr "Versão 0.1.11"

#: src/print_archive/ui/about_content.py:30
msgid ""
"The main preview now supports zoom controls, mouse-wheel zoom, and drag-to-"
"pan."
msgstr ""
"O preview principal agora oferece controles de zoom, zoom pela roda do mouse "
"e navegação por arraste."

#: src/print_archive/ui/about_content.py:31
msgid ""
"Pages can be rotated visually without changing the retained file or reprint "
"orientation."
msgstr ""
"As páginas podem ser giradas visualmente sem alterar o arquivo retido nem a "
"orientação da reimpressão."

#: src/print_archive/ui/about_content.py:32
msgid "Primary actions now use symbolic icons and concise labels."
msgstr "As ações principais agora usam ícones simbólicos e textos concisos."

#: src/print_archive/ui/about_content.py:33
msgid "Apply and onboarding completion labels stay stable while CUPS restarts."
msgstr ""
"Os textos de Aplicar e da conclusão do onboarding permanecem estáveis "
"enquanto o CUPS reinicia."

#: src/print_archive/ui/about_content.py:34
msgid ""
"The GitHub source package now includes bilingual documentation and a "
"complete screenshot gallery."
msgstr ""
"O pacote-fonte do GitHub agora inclui documentação bilíngue e uma galeria "
"completa de capturas de tela."

#: src/print_archive/ui/about_content.py:38
msgid "Version 0.1.10"
msgstr "Versão 0.1.10"

#: src/print_archive/ui/about_content.py:40
msgid ""
"A blocking progress dialog now waits for CUPS after global settings are "
"saved."
msgstr ""
"Um diálogo de progresso bloqueante agora aguarda o CUPS após salvar as "
"configurações globais."

#: src/print_archive/ui/about_content.py:41
msgid "Fresh IPP connections must answer consistently before PyCUPS resumes."
msgstr ""
"Novas conexões IPP precisam responder de forma consistente antes de o PyCUPS "
"continuar."

#: src/print_archive/ui/about_content.py:42
msgid ""
"History refresh is paused so a scheduler restart cannot appear as an "
"application error."
msgstr ""
"A atualização do histórico é pausada para que a reinicialização do servidor "
"não apareça como erro do aplicativo."

#: src/print_archive/ui/about_content.py:43
msgid ""
"If CUPS stays unavailable, PyCUPS keeps retrying automatically while the app "
"remains blocked."
msgstr ""
"Se o CUPS continuar indisponível, o PyCUPS continuará tentando "
"automaticamente enquanto o aplicativo permanecer bloqueado."

#: src/print_archive/ui/about_content.py:47
msgid "Version 0.1.9"
msgstr "Versão 0.1.9"

#: src/print_archive/ui/about_content.py:49
msgid ""
"Welcome and completion headers no longer create isolated internal scrollbars."
msgstr ""
"Os cabeçalhos de boas-vindas e conclusão não criam mais barras de rolagem "
"internas isoladas."

#: src/print_archive/ui/about_content.py:50
msgid ""
"More compact spacing keeps onboarding information visible in the standard "
"window size."
msgstr ""
"Espaçamentos mais compactos mantêm as informações do assistente visíveis no "
"tamanho padrão da janela."

#: src/print_archive/ui/about_content.py:51
msgid ""
"The longer retention form uses only one page-level scrolling fallback when "
"needed."
msgstr ""
"O formulário mais longo de retenção usa somente uma rolagem da página quando "
"necessário."

#: src/print_archive/ui/about_content.py:55
msgid "Version 0.1.8"
msgstr "Versão 0.1.8"

#: src/print_archive/ui/about_content.py:57
msgid ""
"A three-step welcome flow explains privacy, updates, and open-source access."
msgstr ""
"Um fluxo de boas-vindas em três etapas explica a privacidade, as "
"atualizações e o acesso ao código aberto."

#: src/print_archive/ui/about_content.py:58
msgid ""
"Current CUPS retention values are shown beside an editable 30/90-day "
"suggestion."
msgstr ""
"Os valores atuais de retenção do CUPS são exibidos junto de uma sugestão "
"editável de 30/90 dias."

#: src/print_archive/ui/about_content.py:59
msgid ""
"The suggested job-count limit is unlimited so time-based retention is not "
"shortened."
msgstr ""
"O limite sugerido pela quantidade de jobs é ilimitado para não encurtar a "
"retenção baseada em prazo."

#: src/print_archive/ui/about_content.py:60
msgid ""
"Applying remains explicit and protected by administrator authorization; "
"skipping changes nothing."
msgstr ""
"A aplicação continua explícita e protegida por autorização administrativa; "
"pular não altera nada."

#: src/print_archive/ui/about_content.py:61
msgid "The welcome setup can be reopened from the main menu."
msgstr "A configuração de boas-vindas pode ser reaberta pelo menu principal."

#: src/print_archive/ui/about_content.py:65
msgid "Version 0.1.7"
msgstr "Versão 0.1.7"

#: src/print_archive/ui/about_content.py:67
msgid "PyCUPS is now the consistent application name throughout the interface."
msgstr "PyCUPS agora é o nome consistente do aplicativo em toda a interface."

#: src/print_archive/ui/about_content.py:68
msgid "CUPS Archive is retained as the product description."
msgstr "CUPS Archive permanece como a descrição do produto."

#: src/print_archive/ui/about_content.py:69
msgid "Technical identifiers remain compatible with previous installations."
msgstr ""
"Os identificadores técnicos permanecem compatíveis com instalações "
"anteriores."

#: src/print_archive/ui/about_content.py:73
msgid "Version 0.1.6"
msgstr "Versão 0.1.6"

#: src/print_archive/ui/about_content.py:75
msgid "Apply stays fixed below the scrolling Retention and Server forms."
msgstr ""
"Aplicar permanece fixo abaixo dos formulários roláveis de Retenção e "
"Servidor."

#: src/print_archive/ui/about_content.py:76
msgid "Retained print files can now be kept without a time limit."
msgstr ""
"Os arquivos de impressão retidos agora podem ser mantidos sem limite de "
"tempo."

#: src/print_archive/ui/about_content.py:77
msgid "The reprint preview is displayed on the left of its options."
msgstr "O preview da reimpressão é exibido à esquerda das opções."

#: src/print_archive/ui/about_content.py:78
msgid "Per-job spool isolation fixes cached multi-page preview navigation."
msgstr ""
"O isolamento do spool por job corrige a navegação em previews de várias "
"páginas no cache."

#: src/print_archive/ui/about_content.py:82
msgid "Version 0.1.5"
msgstr "Versão 0.1.5"

#: src/print_archive/ui/about_content.py:84
msgid "Long destination-paper names no longer compress the Target paper row."
msgstr ""
"Nomes longos de papel de destino não comprimem mais a linha Papel de destino."

#: src/print_archive/ui/about_content.py:85
msgid ""
"The selected paper uses an ellipsis while the popup keeps the complete names."
msgstr ""
"O papel selecionado usa reticências, enquanto a lista mantém os nomes "
"completos."

#: src/print_archive/ui/about_content.py:86
msgid "The complete selected paper name remains available in a tooltip."
msgstr "O nome completo do papel selecionado permanece disponível em uma dica."

#: src/print_archive/ui/about_content.py:90
msgid "Version 0.1.4"
msgstr "Versão 0.1.4"

#: src/print_archive/ui/about_content.py:92
msgid "The print history is visible immediately after the first CUPS load."
msgstr ""
"O histórico de impressão fica visível imediatamente após a primeira leitura "
"do CUPS."

#: src/print_archive/ui/about_content.py:93
msgid "Printer selection is populated before GTK evaluates job-row visibility."
msgstr ""
"A seleção de impressoras é preenchida antes que o GTK avalie a visibilidade "
"dos jobs."

#: src/print_archive/ui/about_content.py:94
msgid "The list filter is explicitly refreshed after every history rebuild."
msgstr ""
"O filtro da lista é atualizado explicitamente após cada reconstrução do "
"histórico."

#: src/print_archive/ui/about_content.py:98
msgid "Version 0.1.3"
msgstr "Versão 0.1.3"

#: src/print_archive/ui/about_content.py:100
msgid ""
"Filter history with checkboxes for all printers or any selected combination."
msgstr ""
"Filtre o histórico com checkboxes para todas as impressoras ou qualquer "
"combinação selecionada."

#: src/print_archive/ui/about_content.py:101
msgid ""
"Preview a PDF reprint on the destination paper with fit, fill, actual-size, "
"and automatic scaling."
msgstr ""
"Veja o preview da reimpressão PDF no papel de destino com ajuste, "
"preenchimento, tamanho real e escala automática."

#: src/print_archive/ui/about_content.py:102
msgid ""
"Choose paper sizes and scaling advertised by the destination through CUPS "
"IPP attributes."
msgstr ""
"Escolha tamanhos de papel e escalas anunciados pelo destino nos atributos "
"IPP do CUPS."

#: src/print_archive/ui/about_content.py:103
msgid ""
"Check GitHub for validated optional or mandatory updates at startup and on "
"demand."
msgstr ""
"Verifique no GitHub atualizações opcionais ou obrigatórias validadas ao "
"iniciar e sob demanda."

#: src/print_archive/ui/about_content.py:104
msgid ""
"Use tabbed Retention, Server, and Maintenance settings for global CUPS "
"configuration."
msgstr ""
"Use as abas Retenção, Servidor e Manutenção para a configuração global do "
"CUPS."

#: src/print_archive/ui/about_content.py:105
msgid ""
"Expanded About information, project links, credits, release notes, and "
"diagnostic details."
msgstr ""
"Expandidas as informações Sobre, links do projeto, créditos, notas da versão "
"e detalhes de diagnóstico."

#: src/print_archive/ui/about_content.py:109
msgid "Version 0.1.2"
msgstr "Versão 0.1.2"

#: src/print_archive/ui/about_content.py:111
msgid ""
"Added on-demand CUPS authentication for protected retained files and exact "
"restarts."
msgstr ""
"Adicionada autenticação do CUPS sob demanda para arquivos retidos protegidos "
"e reinícios exatos."

#: src/print_archive/ui/about_content.py:112
msgid ""
"Attempted direct retained-file retrieval even when job-preserved was not "
"reported."
msgstr ""
"Tentativa de obter diretamente o arquivo retido mesmo quando job-preserved "
"não era informado."

#: src/print_archive/ui/about_content.py:113
msgid ""
"Added the first printer filter and completed Brazilian Portuguese "
"installation support."
msgstr ""
"Adicionado o primeiro filtro de impressoras e concluído o suporte ao "
"português do Brasil na instalação."

#: src/print_archive/ui/about_content.py:117
msgid "Version 0.1.1"
msgstr "Versão 0.1.1"

#: src/print_archive/ui/about_content.py:119
msgid "Loaded retention controls from the live CUPS configuration."
msgstr ""
"Carregados os controles de retenção a partir da configuração atual do CUPS."

#: src/print_archive/ui/about_content.py:120
msgid ""
"Kept installation and application startup free of automatic CUPS changes."
msgstr ""
"A instalação e a inicialização do aplicativo continuam sem alterações "
"automáticas no CUPS."

#: src/print_archive/ui/about_content.py:124
msgid "Version 0.1.0"
msgstr "Versão 0.1.0"

